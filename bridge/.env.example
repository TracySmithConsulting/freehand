# WhatsApp Bridge Configuration
# Copy to .env and fill in values

# Port for the bridge Express server (communicates with Python)
BRIDGE_PORT=8766

# Python FastAPI server port
PYTHON_PORT=8000

# Base URL for Python API (for webhook callbacks)
# Set this to your Tailscale IP if accessing remotely
# PYTHON_API_URL=http://100.x.y.z:8000
