# FreeHand WhatsApp bridge configuration.
# Copy to .env in this folder and fill in BRIDGE_SECRET.

# Required. Must equal FreeHand's settings "bridge_secret".
# Run `freehand gateway secret` to create one and print it.
BRIDGE_SECRET=

# Where the bridge listens. Keep 127.0.0.1 unless FreeHand runs on another
# machine: anyone who can reach the bridge and knows the secret can send
# WhatsApp messages from the linked number.
BRIDGE_HOST=127.0.0.1
# Must match FreeHand's FREEHAND_BRIDGE_PORT (default 8765).
BRIDGE_PORT=8765

# FreeHand's own address, as seen from the bridge.
FREEHAND_URL=http://127.0.0.1:8000

# Optional: where the linked-device session is stored (default:
# ./auth_info_baileys). Treat that folder like a password.
# WHATSAPP_AUTH_DIR=
