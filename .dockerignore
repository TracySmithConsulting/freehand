# ── Version control ────────────────────────────────────────────────────
.git
.gitignore
.gitattributes
.github

# ── Vault — NEVER bake secrets into the image ──────────────────────────
# Mounted as a volume at runtime so encryption.key, connections.db,
# and broker_config.json persist across container restarts.
vault/

# ── Other secrets — NEVER bake these into the image either ─────────────
# The project .env holds OpenConnector tokens and the Composio API key.
# Every tenant image is built from this checkout, so without these lines
# each customer's image carried the operator's keys. Compose passes the
# values a container needs as environment variables instead.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
# The WhatsApp linked-device session: anyone with a copy can read and send
# messages as that number. The bridge runs on the host, not in the image.
**/auth_info_baileys/
*.key
*.pem

# ── Python build artifacts ─────────────────────────────────────────────
__pycache__
**/__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
*.egg-info
*.egg
build/
dist/

# ── Node.js — FreeHand's package.json is unrelated to OpenConnector ────
node_modules/
**/node_modules/

# ── Local databases (other than vault/connections.db) ─────────────────
*.db
*.db-journal
*.sqlite
*.sqlite3
agent.db

# ── Local logs and operational noise ──────────────────────────────────
*.log
freehand-live.log
freehand-task6.log

# ── Hermes scratch and editor noise ────────────────────────────────────
.hermes/
three-sound-draft-1.md
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# ── Test artifacts ─────────────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# ── Documentation build artifacts (not needed at runtime) ────────────
docs/_build/
site/

# ── Plan files (kept in-repo but not needed in container) ─────────────
.hermes/plans/
