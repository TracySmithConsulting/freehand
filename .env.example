# FreeHand + OpenConnector — environment template
#
# Don't copy this by hand. Run:
#   python scripts/setup_env.py
# It creates .env (which is .gitignored) from this file and fills in
# random values for the secrets below (three for OpenConnector, one for
# memory). compose.yml has no defaults for them and won't start until they
# are set.

# ── OpenConnector admin token ─────────────────────────────────────────
# Used only for OC's admin endpoints (e.g. PUT /api/oauth/configs/<service>).
# FreeHand does NOT need this — it uses the runtime token for catalog probes.
OC_ADMIN_TOKEN=

# ── OpenConnector runtime token ───────────────────────────────────────
# Used by FreeHand for /v1/providers catalog probes (Round 7 tier-5 path).
# Also used by end users via the tier-5 redirect flow.
OC_RUNTIME_TOKEN=

# ── OpenConnector encryption key ─────────────────────────────────────
# Exactly 32 bytes, base64-encoded (openssl rand -base64 32).
# Keep it once OpenConnector has data: a new key makes saved connections
# unreadable.
OC_ENCRYPTION_KEY=

# ── Memory (Hindsight) ───────────────────────────────────────────────
# Lets Hindsight, FreeHand's memory service, use the AI model set up in
# FreeHand, so it only has to be set up once. setup_env.py fills this in.
FREEHAND_LLM_PROXY_TOKEN=
# Optional: give memory its own model instead (OpenAI-compatible API).
#HINDSIGHT_LLM_BASE_URL=https://api.example.com/v1
#HINDSIGHT_LLM_API_KEY=
#HINDSIGHT_LLM_MODEL=
# Which memory bank FreeHand uses (one per person). Also settable in
# vault/settings.json under memory.bank_id.
#FREEHAND_MEMORY_BANK=freehand

# Browser-facing OpenConnector console URL. Keep this at the local default
# for Docker Desktop; set it to the public OC URL in a hosted deployment.
#OOMOL_CONNECT_CONSOLE_URL=http://localhost:3001

# ── Container UID/GID ─────────────────────────────────────────────────
# Match your host user so bind-mounted vault/ and agent.db are writable
# inside the container. Defaults to 1000 (typical Linux desktop user).
#   UID=$(id -u) GID=$(id -g) docker compose up
UID=1000
GID=1000

# ── FreeHand user override (compatibility shim) ───────────────────────
# Docker Desktop on Windows can't propagate host UID mappings to bind
# mounts cleanly (gRPC-FUSE limitation). On Windows, leave FREEHAND_USER
# unset (defaults to 0:0 — runs FreeHand as root in the container,
# which fixes the bind-mount writable issue). On Linux, set this to
# "${UID}:${GID}" to run FreeHand as the matching non-root user.
#   FREEHAND_USER=${UID}:${GID}  →  Linux non-root
#   (unset)                      →  Windows host root (compatibility default)
#FREEHAND_USER=1000:1000

# ── Optional Composio adapter (Facebook / Instagram) ─────────────────
# Composio supplies the hosted OAuth flow and keeps provider tokens out of
# FreeHand. Create managed auth configs in your Composio project and paste
# their ids here. Leave these unset to use FreeHand's existing Meta connector.
#COMPOSIO_API_KEY=
#COMPOSIO_AUTH_CONFIG_FACEBOOK=
#COMPOSIO_AUTH_CONFIG_INSTAGRAM=
#COMPOSIO_BASE_URL=https://backend.composio.dev
