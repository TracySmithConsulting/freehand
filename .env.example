# FreeHand + OpenConnector — environment template
#
# Copy to .env (which is .gitignored) and edit for your install:
#   cp .env.example .env
#
# Defaults in compose.yml are the test values below. For production,
# generate real values:
#   openssl rand -hex 32  →  OC_ADMIN_TOKEN, OC_RUNTIME_TOKEN
#   openssl rand -base64 32  →  OC_ENCRYPTION_KEY (must be 32 bytes)
#   echo "1000"  →  UID, GID (your host user's UID/GID; `id -u`, `id -g`)

# ── OpenConnector admin token ─────────────────────────────────────────
# Used only for OC's admin endpoints (e.g. PUT /api/oauth/configs/<service>).
# FreeHand does NOT need this — it uses the runtime token for catalog probes.
OC_ADMIN_TOKEN=admintest123

# ── OpenConnector runtime token ───────────────────────────────────────
# Used by FreeHand for /v1/providers catalog probes (Round 7 tier-5 path).
# Also used by end users via the tier-5 redirect flow.
OC_RUNTIME_TOKEN=runttest123

# ── OpenConnector encryption key ─────────────────────────────────────
# MUST be exactly 32 bytes (the Fernet key length).
# 32 ASCII chars = 32 bytes. For production, generate via:
#   openssl rand -base64 32
OC_ENCRYPTION_KEY=this-is-a-thirty-two-byte-test-key

# ── Container UID/GID ─────────────────────────────────────────────────
# Match your host user so bind-mounted vault/ and agent.db are writable
# inside the container. Defaults to 1000 (typical Linux desktop user).
#   UID=$(id -u) GID=$(id -g) docker compose up
UID=1000
GID=1000

# ── FreeHand user override (compatibility shim) ───────────────────────
# Docker Desktop on Windows can't propagate host UID mappings to bind
# mounts cleanly (gRPC-FUSE limitation). On Windows, leave FREEHAND_USER
# unset (defaults to 0:0 — runs FreeHand as root in the container,
# which fixes the bind-mount writable issue). On Linux, set this to
# "${UID}:${GID}" to run FreeHand as the matching non-root user.
#   FREEHAND_USER=${UID}:${GID}  →  Linux non-root
#   (unset)                      →  Windows host root (compatibility default)
#FREEHAND_USER=1000:1000
